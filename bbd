def get_price(name, size):
    if name in YATAK_DB and size in YATAK_DB[name]:
        return float(YATAK_DB[name][size])
    # fallback: aynı ölçünün set fiyatının %45'i
    for smap in SET_DB.values():
        if size in smap:
            return round(float(smap[size]) * 0.45, 2)
    return None

